    MyHealth --> EHRxF
    HealthData --> EHRxF
    EHRxF --> FHIR
    EHRxF -.->|移行中| CDA
    IMG --> DICOM
    
    FHIR --> eIDAS
    FHIR --> eDelivery
    FHIR --> Security
    
    classDef app fill:#d0e2ff,stroke:#0043ce,stroke-width:2px
    classDef data fill:#bee1ff,stroke:#0043ce,stroke-width:3px
    classDef standard fill:#a6c8ff,stroke:#0043ce,stroke-width:2px
    classDef infra fill:#e5f6ff,stroke:#0043ce,stroke-width:2px
    
    class MyHealth,HealthData app
    class EHRxF,PS,EP,LR,IMG,HD data
    class FHIR,CDA,DICOM standard
    class eIDAS,eDelivery,Security infra